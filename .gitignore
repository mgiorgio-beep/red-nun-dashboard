# Timestamped editor backups (foo.py.bak.<tag>.<stamp>). The existing *.bak /
# *.bak_* rules do NOT match this dotted form, so they piled up untracked.
# Git history supersedes them — never commit one.
*.bak.*

# Scanned CHECK IMAGES — pictures of signed checks, carrying account and
# routing numbers. Permanent once committed and cloned to every machine that
# pulls. Serve from outside the repo if these ever need to persist.
web/static/check_images/

# Gmail sample dumps from one-off investigations: real vendor addresses, real
# payment amounts, real correspondence snippets. Keep them local.
scripts/archive/*.json
